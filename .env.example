# --- CORREO: envío de las consultas de los formularios ---
# Casilla desde la que se envían los mails y su contraseña.
# Gmail / Google Workspace: usar una "contraseña de aplicación" (no la contraseña real).
# Correo del hosting del dominio: la contraseña de esa casilla.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Servidor SMTP. Ejemplos:
#   Gmail / Google Workspace:  smtp.gmail.com  puerto 587  TLS=True   SSL=False
#   Hosting (cPanel, etc.):    mail.davidrodriguezprop.com  puerto 465  TLS=False  SSL=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# A dónde llegan las consultas de la web (si no se completa, info@davidrodriguezprop.com)
EMAIL_DESTINO_CONSULTAS=info@davidrodriguezprop.com

# API key de Gemini (Google AI) para generar descripciones de propiedades con IA
GEMINI_API_KEY=
